<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_theme_midnight"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Status Bar Row (Prominent Glassmorphic Container) -->
    <RelativeLayout
        android:id="@+id/viewStatusBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_glass_dock_prominent"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: Time & Date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/tv_font"
                android:textColor="@color/text_primary"
                tools:text="10:36 PM" />

            <TextView
                android:id="@+id/tvClockDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   |   "
                android:textSize="16sp"
                android:fontFamily="@font/tv_font"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:fontFamily="@font/tv_font"
                android:textColor="@color/text_secondary"
                tools:text="Fri, Aug 14" />
        </LinearLayout>

        <!-- Right: Indicators & Settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 1. WiFi / Ethernet Signal Indicator -->
            <ImageView
                android:id="@+id/ivWifiStatus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_status_bar_selector"
                android:src="@drawable/ic_wifi_full"
                android:contentDescription="Network Settings" />

            <!-- 2. Bluetooth Status Indicator -->
            <ImageView
                android:id="@+id/ivBluetoothStatus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_status_bar_selector"
                android:src="@drawable/ic_bluetooth_off"
                android:contentDescription="Bluetooth Settings" />

            <!-- 3. VPN Status Indicator (Visible when VPN connection is detected) -->
            <ImageView
                android:id="@+id/ivVpnStatus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_status_bar_selector"
                android:src="@drawable/ic_vpn"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="VPN Settings" />

            <!-- 4. USB / OTG Drive Indicator (Pure indicator, not clickable) -->
            <ImageView
                android:id="@+id/ivUsbStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:focusable="false"
                android:clickable="false"
                android:src="@drawable/ic_usb_storage"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="USB Storage" />

            <!-- 5. Settings Quick Action Button -->
            <ImageView
                android:id="@+id/ivSettingsBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_status_bar_selector"
                android:src="@drawable/ic_settings_gear"
                android:contentDescription="Launcher Settings" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Top-Center Star Icon Header (Outside Dock Container) -->
    <ImageView
        android:id="@+id/ivFavoritesDockStar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_star_filled"
        android:tint="@color/accent_gold"
        android:contentDescription="Favorites"
        app:layout_constraintBottom_toTopOf="@id/layoutFavoritesSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STAGE 1: Favorites Section Hero Dock (Anchored firmly at the bottom) -->
    <LinearLayout
        android:id="@+id/layoutFavoritesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_dock_prominent"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Empty State Placeholder matching 1-row height -->
        <FrameLayout
            android:id="@+id/layoutFavoritesEmpty"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFavoritesEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Empty, please put your favorite apps here"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium"
                android:textColor="@color/text_secondary" />
        </FrameLayout>

    </LinearLayout>

    <!-- Top-Center Apps Grid Header with Icon & Page Indicator (Outside Dock Container) -->
    <LinearLayout
        android:id="@+id/layoutAppsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutAppsSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivAppsSectionIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_apps_grid"
            android:tint="@color/accent_cyan"
            android:contentDescription="Apps" />

        <LinearLayout
            android:id="@+id/layoutPageDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- STAGE 2: Apps & Games Grid Section (Enclosed in Glassmorphic Dock Containment) -->
    <LinearLayout
        android:id="@+id/layoutAppsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_glass_dock_prominent"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Apps Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
