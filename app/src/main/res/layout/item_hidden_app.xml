<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_glass_dock">

    <ImageView
        android:id="@+id/ivHiddenAppIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        tools:src="@android:drawable/sym_def_app_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHiddenAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/tv_font"
            android:textColor="@color/text_primary"
            tools:text="App Name" />

        <TextView
            android:id="@+id/tvHiddenAppPkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="@font/tv_font"
            android:textColor="@color/text_muted"
            tools:text="com.example.app" />
    </LinearLayout>

    <Button
        android:id="@+id/btnUnhideApp"
        android:layout_width="100dp"
        android:layout_height="38dp"
        android:background="@drawable/btn_dialog_solid_selector"
        android:text="Unhide"
        android:textAllCaps="false"
        android:fontFamily="@font/tv_font"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

</LinearLayout>
