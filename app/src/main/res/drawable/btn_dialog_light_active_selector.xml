<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Focus blue background with dark blue border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#2563EB" />
            <stroke android:width="2dp" android:color="#1D4ED8" />
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1D4ED8" />
            <stroke android:width="2dp" android:color="#1D4ED8" />
        </shape>
    </item>
    <!-- Default Active State: Blue outline with soft sky fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#200284C7" />
            <stroke android:width="2dp" android:color="#0284C7" />
        </shape>
    </item>
</selector>
