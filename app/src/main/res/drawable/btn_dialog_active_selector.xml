<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Focus white background with cyan border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#38BDF8" />
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#38BDF8" />
            <stroke android:width="2dp" android:color="#38BDF8" />
        </shape>
    </item>
    <!-- Default Active State: Luminous cyan outline with translucent fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#2638BDF8" />
            <stroke android:width="2dp" android:color="#38BDF8" />
        </shape>
    </item>
</selector>
