<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- TV Stand Base -->
    <item
        android:top="45dp"
        android:bottom="0dp"
        android:left="18dp"
        android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#2563EB" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- TV Stand Neck -->
    <item
        android:top="38dp"
        android:bottom="4dp"
        android:left="27dp"
        android:right="27dp">
        <shape android:shape="rectangle">
            <solid android:color="#3B82F6" />
        </shape>
    </item>
    <!-- TV Screen Outer Bezel & Screen Background -->
    <item
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#111827" />
            <stroke
                android:width="2.5dp"
                android:color="#3B82F6" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
