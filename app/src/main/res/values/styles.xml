<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Leanback Theme -->
    <style name="Theme.AndSmartTV.Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_theme_midnight</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/tv_font</item>
        <item name="fontFamily">@font/tv_font</item>
        <item name="android:buttonStyle">@style/Widget.AndSmartTV.Button</item>
    </style>

    <!-- Dialog Style -->
    <style name="Theme.AndSmartTV.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_glass</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:fontFamily">@font/tv_font</item>
        <item name="fontFamily">@font/tv_font</item>
        <item name="android:buttonStyle">@style/Widget.AndSmartTV.Button</item>
    </style>

    <!-- Flat TV Button Style (No shadow blur / state list animator elevation) -->
    <style name="Widget.AndSmartTV.Button" parent="Widget.AppCompat.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
</resources>
